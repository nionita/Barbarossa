Name:                Barbarossa
Version:             0.8.0
Synopsis:            UCI chess engine written in Haskell
License:             BSD3
License-file:        LICENSE
Author:              Nicu Ionita
Maintainer:          nicu.ionita@acons.at
Copyright:           Nicu Ionita 2013 - 2025
Category:            Game
Build-type:          Simple
Cabal-version:       >=1.8

Flag ddump
  Description:  Enable ddumps
  Default:      True

Flag qscollect
  Description:  Collect quiescence tuning data (origin position payload)
  Default:      True

Flag reproselfplay
  Description:  SelfPlay-only reproducible history init (newHist = 0)
  Default:      False

Executable Barbarossa
  Main-is:	Main/Barbarossa.hs
  Build-depends:
      base >= 4.18,
      array,
      time,
      containers,
      mtl,
      parsec,
      vector,
      vector-algorithms,
      random,
      directory,
      transformers,
      QuickCheck,
      text,
      template-haskell
  Other-modules:
      SelfPlay.SPRT,
      Eval.Core,
      Eval.FileParams,
      Hash.TransTab,
      Hash.Zobrist,
      Moves.Core,
      Moves.Internal.BitBoard,
      Moves.Internal.Pattern,
      Moves.Internal.Magics,
      Moves.Internal.GenMagics,
      Moves.Internal.Moves,
      Moves.Internal.BaseTypes,
      Moves.Internal.Base,
      Moves.History,
      Moves.Notation,
      Moves.ShowMe,
      Search.CStateMonad,
      Search.AlbetaTypes,
      Search.Core,
      Struct.Config,
      Struct.Params,
      Struct.Weights,
      Struct.ParamsPre,
      Struct.ParamsPost,
      Struct.MidEnd,
      Struct.Context,
      Struct.Status,
      Struct.Struct,
      Uci.UCI,
      Uci.UciGlue
  GHC-Options: -O2 -Wall
               -funbox-strict-fields
               -threaded
               -rtsopts -with-rtsopts=-N1
               -fspec-constr-count=24
        --     -funfolding-use-threshold=32
               -fno-warn-tabs
               -msse4.2
               -optl-s
  CPP-Options: -DSMSTRICT
  if flag(qscollect)
    CPP-Options: -DQS_COLLECT
  if flag(ddump)
    GHC-Options: -ddump-simpl -ddump-to-file -dsuppress-all -dsuppress-uniques
                 -ddump-opt-cmm -ddump-asm
                 -ddump-splices

